CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    activo INTEGER NOT NULL,
    categoriaId INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT *
FROM producto
ORDER BY nombre ASC;

buscarPorId:
SELECT *
FROM producto
WHERE id = ?;

listarPendientes:
SELECT *
FROM producto
WHERE pendiente = 1;

insertar:
INSERT OR REPLACE INTO producto (
    id, nombre, precio, stock, activo, categoriaId, pendiente
)
VALUES (?, ?, ?, ?, ?, ?, ?);

borrarPorId:
DELETE FROM producto
WHERE id = ?;

borrarSincronizados:
DELETE FROM producto
WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0)
FROM producto;
registrarFallo:
UPDATE producto SET intentos = ?, ultimoError = ? WHERE id = ? AND pendiente = 1;

restablecerEnvio:
UPDATE producto SET intentos = 0, ultimoError = NULL WHERE id = ? AND pendiente = 1;
